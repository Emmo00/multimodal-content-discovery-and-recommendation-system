# Copy this file to .env and replace placeholder values as needed.
# The application does not load .env files automatically; export these
# variables in your shell or use your environment manager.

# Optional PostgreSQL connection string for persistent deployments.
# The demo and default API use in-memory storage instead.
INTELLIVERSE_DATABASE_URL=postgresql://username:password@localhost:5432/intelliverse

# Retrieval settings
INTELLIVERSE_TOP_K=50
INTELLIVERSE_MIN_TOP_SIMILARITY=0.35
INTELLIVERSE_MIN_RESULT_SIMILARITY=0.15

# Embedding model
INTELLIVERSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional YouTube Data API v3 key for YouTube discovery.
YOUTUBE_API_KEY=your-youtube-api-key
